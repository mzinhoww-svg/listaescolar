# Supabase (chaves no formato novo: sb_publishable_ e sb_secret_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Origem canônica do site (links de login). Local: descomente e use http://127.0.0.1:3000
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# IA via OpenRouter (um adapter, modelos por configuração)
OPENROUTER_KEY=
AI_MODEL_CHEAP=deepseek/deepseek-chat
AI_MODEL_STRONG=z-ai/glm-4.6
AI_MODEL_VISION=

# Observabilidade (opcional na S00)
SENTRY_DSN=

# Notificações Web Push (fatia S11)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Afiliados (fatia S12)
MELI_AFFILIATE_ID=
AMAZON_ASSOCIATE_TAG=
# Opcional: matt_word do Mercado Livre (omitido da URL se vazio)
MELI_AFFILIATE_WORD=

# Demonstração de varejistas (fatia S12). Sem valor = desligado. Só vale em preview/development da
# Vercel, ou local com Supabase em loopback; nunca em produção.
# DEMO_RETAILERS=1
