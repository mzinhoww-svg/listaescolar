# Supabase (chaves no formato novo: sb_publishable_ e sb_secret_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Origem canônica do site (links de login). Local: descomente e use http://127.0.0.1:3000
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# IA via OpenRouter (um adapter, modelos por configuração)
OPENROUTER_KEY=
AI_MODEL_CHEAP=deepseek/deepseek-chat
AI_MODEL_STRONG=z-ai/glm-4.6
AI_MODEL_VISION=
# Só teste/E2E local (nunca em produção; exige APP_ENV local|development|preview|staging): provedor FALSO, sem rede.
# JSON {"cheap":[passos],"strong":[passos],"vision":[passos]}; ver docs/superpowers/e2e/S08.md. Não defina em produção.
# FAKE_AI_SCRIPT=
# Sem OPENROUTER_KEY e AI_MODEL_CHEAP/AI_MODEL_STRONG (nem fake) o envio diz "leitura automática indisponível".
# Imagens usam SÓ a rota de visão (AI_MODEL_VISION, um modelo que aceite imagem); sem ela, foto falha fechada.
# Foto com baixa confiança NÃO escala para AI_MODEL_STRONG (pode ser só texto): fica com aviso e revisão humana.
# O worker lê os mesmos nomes como secrets.

# Observabilidade (opcional na S00)
SENTRY_DSN=

# Notificações Web Push (fatia S11)
# Em desenvolvimento: `node scripts/vapid-dev.mjs` grava um par local em .env.local (nunca imprime a privada; recusa produção).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou https: de contato (exigido pelo protocolo Web Push)
VAPID_SUBJECT=
# Segredo (16+ caracteres) do despacho: POST /api/notifications/dispatch (kick, pg_cron) e GET do Vercel Cron (o Vercel envia CRON_SECRET).
NOTIFICATIONS_DISPATCH_SECRET=
# E-mail de notificação: DESLIGADO por padrão. Só liga com =1 E chave E remetente (conta do provedor é do humano); o gatilho do banco
# também depende de notification_settings.email_enabled (padrão false).
EMAIL_NOTIFICATIONS_ENABLED=0
EMAIL_API_KEY=
EMAIL_FROM=

# Afiliados (fatia S12)
MELI_AFFILIATE_ID=
AMAZON_ASSOCIATE_TAG=
# Opcional: matt_word do Mercado Livre (omitido da URL se vazio)
MELI_AFFILIATE_WORD=

# Demonstração de varejistas (fatia S12). Sem valor = desligado. Só vale em preview/development da
# Vercel, ou local com Supabase em loopback; nunca em produção.
# DEMO_RETAILERS=1

# S07: pipeline de demonstração (nunca em produção) e segredo da Edge Function ocr-worker
DEMO_PIPELINE=
# local | development | preview | staging | production. O demo só liga com DEMO_PIPELINE=1 E APP_ENV explícito não produtivo;
# APP_ENV ausente = demo desligado. DEMO_PIPELINE=1 fora disso derruba o boot.
APP_ENV=
WORKER_SHARED_SECRET=

# S06: entrega de token de reivindicação (link de e-mail / código de WhatsApp). Sem provedor real nesta fatia (e-mail na S11;
# WhatsApp depende de credencial do humano). Com DEMO_CLAIM_DELIVERY=1, APP_ENV=local|development e escola demo, o link/código
# só é impresso no log do servidor. Fora disso os métodos por token aparecem "indisponíveis". Nunca em produção.
# DEMO_CLAIM_DELIVERY=1
# Cron de expiração de leads (fatia S14): a Vercel envia `Authorization: Bearer $CRON_SECRET` em /api/cron/leads-expire.
# Mínimo de 16 caracteres; sem valor, a rota responde 503. Só servidor; nunca no cliente.
CRON_SECRET=

# S09: portas de publicação EM MEMÓRIA (só testes/E2E). JSON com escolas, vínculos, mapa série->slug e anos válidos.
# Só vale com APP_ENV=local ou development (NUNCA preview/staging: o staging é o Supabase real e ai_decisions é append-only).
# Sem valor: toda decisão vai a revisão humana (publisher_unavailable/context_unavailable). Sem valores aqui.
# FAKE_PUBLICATION_FIXTURE=

# S21: cobrança da papelaria. Carteira demo usa DEMO_RETAILERS (acima); Pix real fica atrás da flag, sem nenhuma
# credencial de exemplo aqui (pendência humana: escolher o PSP, criar conta, certificado mTLS, chave Pix, cadastrar
# o webhook). Sem PAYMENTS_PIX_ENABLED=1 ou com config incompleta, Pap06 mostra "Pagamento via Pix indisponível".
PAYMENTS_PIX_ENABLED=
PIX_API_BASE_URL=
PIX_OAUTH_TOKEN_URL=
PIX_CLIENT_ID=
PIX_CLIENT_SECRET=
# PEM do certificado e da chave do cliente (mTLS), cada um em base64 numa linha só.
PIX_CERT_PEM_BASE64=
PIX_KEY_PEM_BASE64=
# Chave Pix (e-mail, telefone, CPF/CNPJ ou aleatória) que recebe o valor.
PIX_RECEIVER_KEY=
# Token no PATH do webhook, 16+ caracteres; sem ele, a rota responde 503. Cadastre no painel do PSP a URL
# https://<seu-domínio>/api/billing/pix/webhook/<PIX_WEBHOOK_TOKEN> (SEM barra no fim) — o BACEN entrega a
# notificação em "<urlCadastrada>/pix", por isso a rota é "catch-all" ([...path]) e aceita esse sufixo.
# A URL COM o token embutido é, na prática, uma credencial: não cole em issue, PR, chat nem log. Gere com
# `openssl rand -hex 24` (ou equivalente) e trate como um segredo, igual a CRON_SECRET.
PIX_WEBHOOK_TOKEN=
# Validade (segundos) da cobrança Pix gerada (calendario.expiracao). Ex.: 3600 = 1 hora.
PIX_CHARGE_TTL_SECONDS=

# Pesquisa com mães (docs/superpowers/specs/2026-09-25-pesquisa-maes-design.md). Ambas obrigatórias só para
# as rotas app/api/pesquisa/**; gerar valores aleatórios com pelo menos 16 caracteres.
PESQUISA_RESULTS_PASSWORD=
IP_HASH_SALT=

# Indexamento (D-075): o deploy "de produção" da Vercel aponta para o staging até o go-live. Robots, sitemap e a remoção do
# X-Robots-Tag: noindex exigem VERCEL_ENV=production E SITE_INDEXING=1. Ligar SÓ no go-live (S20); sem valor = noindex.
SITE_INDEXING=
